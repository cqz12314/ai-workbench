APP_NAME=AI Workbench API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/ai_workbench.db
CORS_ORIGINS=["http://localhost:5173"]
RAG_ENABLED=true
AGENT_ENABLED=false
GITHUB_ENABLED=true
GITHUB_WRITE_ENABLED=false
GITHUB_TOKEN=
# Optional GitHub Enterprise API endpoint
GITHUB_API_BASE=https://api.github.com
WORKSPACE_ENABLED=false
WORKSPACE_ROOT=
CODE_INDEX_ENABLED=false
GIT_ENABLED=false

# LiteLLM model identifier. DeepSeek examples:
# deepseek/deepseek-v4-flash or deepseek/deepseek-v4-pro
LITELLM_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# Other LiteLLM providers remain supported; set their standard key when selected.
OPENAI_API_KEY=
